#!/bin/sh /etc/rc.common
# wgpathd — procd service (persistent uloop daemon).
USE_PROCD=1
START=95
STOP=10

LIBEXEC=/usr/libexec/wgpathd

extra_command "check" "Validate configuration and substrate"
extra_command "migrate" "Move peer settings left in /etc/config/network to /etc/config/wgpathd"

service_enabled() {
	local enabled
	config_load wgpathd
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ]
}

# $1: what happens when the configuration is invalid
config_valid() {
	local report
	report=$("$LIBEXEC/check.uc" --config 2>&1) && return 0
	echo "$report" | logger -s -t wgpathd -p daemon.err
	logger -s -t wgpathd -p daemon.err "$1"
	return 1
}

start_service() {
	service_enabled || return 0
	# An instance that cannot load its config would only crash-loop under respawn.
	config_valid "invalid configuration, not starting" || return 1

	procd_open_instance wgpathd          # instance name used by the watchdog ping
	procd_set_param command "$LIBEXEC/daemon.uc"
	procd_set_param respawn 3600 5 0   # fail-safe: respawn -> start-in-RELAY
	# Passive watchdog (mode 1), 30 s. The daemon re-arms it at the end
	# of each completed cycle via
	#   ubus call service watchdog '{"name":"wgpathd","instance":"wgpathd"}'
	# so a HUNG uloop stops pinging and procd restarts it (respawn is set).
	procd_set_param watchdog 1 30
	procd_set_param stderr 1
	procd_close_instance
}

# No `procd_set_param file`: a changed file would restart the daemon instead of reloading it.
service_triggers() {
	procd_add_reload_trigger "wgpathd" "network"
}

# Disabled or not running: start registers the right instance set (none, or a fresh one).
reload_service() {
	if service_enabled && service_running wgpathd; then
		config_valid "invalid configuration, keeping the running one" || return 1
		procd_send_signal wgpathd wgpathd HUP
	else
		start
	fi
}

status_service() {
	local code
	_procd_status wgpathd "$1"
	code=$?
	if ! service_enabled; then
		echo "disabled (option enabled in /etc/config/wgpathd)"
	elif [ "$code" = 0 ] && service_running wgpathd; then
		"$LIBEXEC/status.uc"
	fi
	return "$code"
}

check() {
	"$LIBEXEC/check.uc"
}

migrate() {
	"$LIBEXEC/migrate.uc"
}
