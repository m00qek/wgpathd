# wgpathd config. Rendered per-role by the estate build layer; this default is a
# template. See the design record (Configuration & operator journey).

# --- SPOKE (routers) — byte-for-byte identical on every spoke ---
config wgpathd 'main'
	option role       'spoke'
	option mesh_iface  'wg_mesh'
	option hub_iface   'wg_hub'
	option discovery   'http://10.10.0.1:7780/peers'

