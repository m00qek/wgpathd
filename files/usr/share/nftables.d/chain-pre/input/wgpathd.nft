# wgpathd fw4 include, prepended to the input chain. It ships with the package so its
# firewall needs cannot be forgotten; each rule is harmless where its role does not apply.
# Rules matched by interface kind need no device name: only a peer with a valid key
# can deliver a packet out of a WireGuard interface.

# Spoke: the underlay ICMPv6 echo probe from mesh peers arrives on the WAN.
# TODO: scope saddr to mesh peers' v6 once confirmed in the harness.
icmpv6 type echo-request accept comment "wgpathd: underlay probe"

# Spoke: the in-tunnel ICMP echo probe (design T1).
meta iifkind "wireguard" icmp type echo-request accept comment "wgpathd: tunnel probe"

# Hub: the discovery publisher, reachable through WireGuard only.
meta iifkind "wireguard" tcp dport 7780 accept comment "wgpathd: discovery publisher"

# Spoke: relayed wg_mesh datagrams arrive on the wg_hub interface (design "Relay endpoint").
# TODO: follow wg_mesh's listen port if it is ever not 51820.
meta iifkind "wireguard" udp dport 51820 accept comment "wgpathd: relay ingress"
